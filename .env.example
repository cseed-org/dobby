# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme

# ── Bot ───────────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# At least one allowed user or role is required. Comma-separated Discord IDs.
ALLOWED_USER_IDS=
ALLOWED_ROLE_IDS=
# Optional channel restriction (empty permits any channel in the guild).
ALLOWED_CHANNEL_IDS=
# Restrict mentions to these exact channel IDs. Empty = any allowed channel.
MENTION_CHANNEL_IDS=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
TEAM_TIMEZONE=America/Los_Angeles
# Recent human messages Dobby reads from the channel for context on each request (read live, never stored).
CONTEXT_MESSAGE_LIMIT=50

# Composio API key (shared by bot and dashboard)
COMPOSIO_API_KEY=
# One Composio entity owns Dobby's Google Calendar / Notion / Instagram / LinkedIn connections.
# Admins connect them on the dashboard; nobody links a personal account.
COMPOSIO_ENTITY_ID=dobby
# Instagram Business/Creator account ID (from the connected Meta app). Required for /instagram.
INSTAGRAM_USER_ID=
# Optional: Notion page ID that /notion note creates pages under.
NOTION_PARENT_PAGE_ID=

# Docker UID/GID — use `id -u` / `id -g` on Linux/Pi; keep defaults on Windows.
DOBBY_UID=10001
DOBBY_GID=10001

# ── Dashboard ─────────────────────────────────────────────────────────────────
# Random 32+ byte hex secret for signing session cookies.
SECRET_KEY=

# Google OAuth app (restrict to uw.edu hosted domain in Google Cloud Console).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth app (add redirect: API_URL/auth/discord/callback). Can be the bot's own application.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Where browsers reach the web UI (CORS origin and post-login redirect target).
DASHBOARD_URL=http://localhost:3000
# Where browsers reach the API. Baked into the frontend at build time; OAuth redirect URIs use this host.
API_URL=http://localhost:8000

# UW email of the first admin — seeded into users table on dashboard startup.
BOOTSTRAP_ADMIN_EMAIL=
